VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_QA_TEST_PASSWORD=
VITE_QA_TEST_ACCOUNTS=

# Server-only setup values. Never prefix private keys with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
APP_BASE_URL=
# Comma-separated extra app origins allowed to set invite/reset email links via the
# request Origin header (e.g. https://app.getbizlee.com,https://solarworkflows-production.up.railway.app).
# Any Origin not listed here (and not equal to APP_BASE_URL) falls back to APP_BASE_URL.
APP_ALLOWED_ORIGINS=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=

# Supabase Auth Send SMS Hook
# Supabase generates/verifies the OTP; the hook delivers it through WhatsApp.
# Generate a Standard Webhooks secret in the form v1,whsec_<base64> in the
# Supabase Auth Hooks dashboard and use the same value in the hook and function.
SEND_SMS_HOOK_URI=
SEND_SMS_HOOK_SECRET=

# Meta WhatsApp Cloud API credentials used only for platform signup OTPs.
# These values are server-only. Never prefix them with VITE_.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_API_VERSION=

# Approved WhatsApp authentication template configuration.
# Use the exact template name and language code from WhatsApp Business Manager.
META_WHATSAPP_OTP_TEMPLATE_NAME=
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE=

# Meta webhook verification and signature validation.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# Bizlee subscriptions. Create ₹999/₹1499 monthly plans and ₹10989/₹16489
# yearly plans (one month free) in Razorpay. Keep all secrets server-side.
# Ask Razorpay to enable Subscriptions with UPI AutoPay on the merchant account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_MONTHLY_PLAN_ID=
RAZORPAY_STARTER_YEARLY_PLAN_ID=
RAZORPAY_PREMIUM_MONTHLY_PLAN_ID=
RAZORPAY_PREMIUM_YEARLY_PLAN_ID=

# GST invoice issuer details for Bizlee subscription payments.
BILLING_LEGAL_NAME=
BILLING_GSTIN=
BILLING_ADDRESS=
BILLING_SAC_CODE=998314

# Trial reminder worker and transactional email delivery.
TRIAL_REMINDER_WORKER_SECRET=
RESEND_API_KEY=
TRIAL_REMINDER_FROM_EMAIL=
TRIAL_SIGNUP_WORKER_SECRET=
# Optional comma-separated override. If empty, active super-admin emails receive
# new trial signup notifications.
TRIAL_SIGNUP_NOTIFICATION_EMAIL=

# Tenant notification dispatcher. It is fail-closed in test mode by default.
NOTIFICATION_WORKER_SECRET=
MOBILE_PUSH_WORKER_SECRET=
NOTIFICATION_TEST_MODE=true
# Comma-separated E.164 recipients without spaces, used only in test mode.
NOTIFICATION_TEST_RECIPIENTS=
DAILY_SUMMARY_WORKER_SECRET=
