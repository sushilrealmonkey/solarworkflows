{
  "name": "solarworkflows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "start": "node --env-file-if-exists=.env server-dist/index.js",
    "test:webhook": "tsc -p tsconfig.server.json && node --test server-dist/modules/whatsapp/webhook.test.js",
    "test:mobile-api": "tsc -p tsconfig.server.json && node --test server-dist/modules/mobile-api/handler.test.js",
    "test:emails": "node --experimental-strip-types --test supabase/functions/_shared/trial-welcome-email.test.ts",
    "setup:super-admin": "node scripts/setup-super-admin.mjs",
    "preview": "vite preview"
    ,"mobile:start": "npm run start --workspace=@bizlee/mobile"
    ,"mobile:check": "npm run check --workspace=@bizlee/mobile"
    ,"contracts:check": "npm run check --workspace=@bizlee/contracts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "jspdf": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.27.0",
    "vite": "^6.2.3"
  }
}
