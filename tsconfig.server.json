{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "server",
    "outDir": "server-dist",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["server/**/*.ts"]
}
